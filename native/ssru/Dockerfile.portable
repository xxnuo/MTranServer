# Official images: https://github.com/pypa/manylinux#manylinux_2_28-almalinux-8-based
# Digests resolved from quay.io/pypa/manylinux_2_28_{x86_64,aarch64}:latest
# with `docker buildx imagetools inspect` on 2026-11-15; GCC toolset, glibc 2.28.
ARG TARGETARCH
FROM quay.io/pypa/manylinux_2_28_x86_64@sha256:d086f64cddcace250ef0f0073583c51b8298159303290a730c9f59bd91edfd2c AS builder-amd64
FROM quay.io/pypa/manylinux_2_28_aarch64@sha256:34a5e614a4eb26f73f8bf44cbbf2acf8011620453d03ea35a58537bb3cde44de AS builder-arm64
FROM builder-${TARGETARCH} AS builder
WORKDIR /src
ENTRYPOINT ["/bin/bash", "/src/scripts/build-portable-native.sh", "--container"]
